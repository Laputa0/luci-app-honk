#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

extra_command "hot_reload" "Hot-reload service"
extra_command "update_dns" "Update hijacked resolv.conf"

CONF="honk"
PROG="/usr/bin/honk-core"
# honk-core hardcodes dae-compatible datapath names (dae0/dae0peer + daens);
# these are the real interface/netns names, not leftover dae config.
HONK_HOST_IFACE="dae0"
HONK_PEER_IFACE="dae0peer"
HONK_NETNS_NAME="daens"
HONK_NETNS_PATH="/run/netns/$HONK_NETNS_NAME"
RESOLV_HONK="/tmp/resolv.conf.honk"

set_chmod_640() {
    mkdir -p /etc/honk/config.d /etc/honk/state
    chmod -R u=rwX,go= /etc/honk 2>/dev/null || true
    chmod 700 /etc/honk /etc/honk/config.d /etc/honk/state 2>/dev/null || true
}

cleanup_netns() {
    ip netns del "$HONK_NETNS_NAME" 2>/dev/null || true
    umount "$HONK_NETNS_PATH" 2>/dev/null || true
    rm -f "$HONK_NETNS_PATH" 2>/dev/null || true
    ip link del "$HONK_HOST_IFACE" 2>/dev/null || true
    ip link del "$HONK_PEER_IFACE" 2>/dev/null || true
}

hijack_resolv_conf() {
    local auto_file="/tmp/resolv.conf.d/resolv.conf.auto"
    [ -s "$auto_file" ] || auto_file="/tmp/resolv.conf.auto"
    local tmp="$RESOLV_HONK.tmp"

    [ -f /tmp/resolv.conf ] || touch /tmp/resolv.conf
    grep -E '^(search|domain) ' /tmp/resolv.conf > "$tmp" 2>/dev/null || true

    if [ -s "$auto_file" ]; then
        awk '
        /^# Interface/ {
            iface = $3
            sub(/([_-]?6)$/, "", iface)
            next
        }
        /^nameserver/ && iface != "" {
            if (!seen_iface[iface]) {
                seen_iface[iface] = 1
                ifaces[++count] = iface
            }
            if (!seen_dns[iface, $2]) {
                seen_dns[iface, $2] = 1
                if (dns_cnt[iface] < 3) {
                    dns_cnt[iface]++
                    dns[iface, dns_cnt[iface]] = $2
                }
            }
        }
        END {
            if (count == 1) {
                for (i = 1; i <= dns_cnt[ifaces[1]]; i++) {
                    print "nameserver " dns[ifaces[1], i]
                }
            } else {
                print "nameserver 223.5.5.5"
                print "nameserver 119.29.29.29"
                print "nameserver 2400:3200::1"
            }
        }
        ' "$auto_file" >> "$tmp" 2>/dev/null
    fi

    if ! grep -q '^nameserver' "$tmp" 2>/dev/null; then
        echo "nameserver 223.5.5.5" >> "$tmp"
        echo "nameserver 119.29.29.29" >> "$tmp"
        echo "nameserver 2400:3200::1" >> "$tmp"
    fi

    cat "$tmp" > "$RESOLV_HONK"
    rm -f "$tmp"

    if ! grep -Fq ' /tmp/resolv.conf ' /proc/mounts; then
        mount --bind "$RESOLV_HONK" /tmp/resolv.conf
        mount -o remount,ro,bind /tmp/resolv.conf
    fi
}

restore_resolv_conf() {
    while grep -Fq ' /tmp/resolv.conf ' /proc/mounts; do
        mount -o remount,rw,bind /tmp/resolv.conf 2>/dev/null
        umount /tmp/resolv.conf 2>/dev/null || break
    done
    rm -f "$RESOLV_HONK"
}

start_service() {
    local enabled config_file

    config_load "$CONF"
    config_get_bool enabled "config" "enabled" "0"
    [ "$enabled" -eq "1" ] || return 1

    config_get config_file "config" "config_file" "/etc/honk/config.dae"

    set_chmod_640
    cleanup_netns
    hijack_resolv_conf

    procd_open_instance "$CONF"
    procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray"
    procd_set_param command "$PROG" --config "$config_file"
    procd_set_param netdev "$HONK_HOST_IFACE" "$HONK_PEER_IFACE"
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param term_timeout 8
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

service_stopped() {
    restore_resolv_conf
    cleanup_netns
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
    procd_add_raw_trigger "interface.*" 2000 /etc/init.d/honk update_dns
}

update_dns() {
    /etc/init.d/honk running || return 0
    hijack_resolv_conf
}

hot_reload() {
    set_chmod_640
    hijack_resolv_conf
    if /etc/init.d/honk running; then
        "$PROG" reload
    else
        /etc/init.d/honk restart
    fi
}
